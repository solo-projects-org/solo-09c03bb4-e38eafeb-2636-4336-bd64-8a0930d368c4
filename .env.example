# 复制为 .env 后可被 docker compose 自动读取；下列均为默认值
APP_AET=RETRIEVER
PACS_AET=MYPACS
STORE_PORT=11113
PACS_PORT=11112
# 数据卷 DICOM 实例字节配额（所有批共享，已存文件 + 在途预留合计上限）。
# 0 = 不限额；演示默认 165KB，使后续批在容量耗尽时“额度不足仅该批失败”。
QUOTA_LIMIT_BYTES=168960
# 模拟 PACS 每个实例发送间隔（秒），调大可更清楚观察交错回传
MOVE_DELAY=1.0
# 每 N 个实例重复投送一次（0 关闭）
MOVE_DUPLICATE_EVERY=3
# 三个虚构检查各自的 CT 实例数
STUDY_COUNTS=8,6,5
